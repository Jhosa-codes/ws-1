; Configuração do projeto PokéSphere (ws-1) — Godot 4.7.
config_version=5

[application]

config/name="PokéSphere"
config/description="Reimaginação 2.5D side-view de Pokémon Crystal com combate em tempo real."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

